@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = $"Customer - {Model.CustomerName}";
    var auditLogs = ViewBag.AuditLogs as IEnumerable<AcxiomCRM.Models.AuditLog> ?? Enumerable.Empty<AcxiomCRM.Models.AuditLog>();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="fw-bold mb-0 text-dark">@Model.CustomerName</h3>
            <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Status</span>
        </div>
        <div class="text-muted small">Customer ID: <strong class="text-primary">@Model.CustomerCode</strong> | Created on @Model.CreatedDate.ToString("MMMM dd, yyyy") by @Model.CreatedBy</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-briefcase me-1"></i> Add Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-clock-history me-1"></i> Log Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Customer
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Customer Info Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 h-100">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge text-primary me-2"></i>Contact Details</h5>
            <dl class="row mb-0 small">
                <dt class="col-sm-4 text-muted">Email</dt>
                <dd class="col-sm-8 fw-semibold text-break"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                <dt class="col-sm-4 text-muted">Phone</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Phone</dd>

                <dt class="col-sm-4 text-muted">Company</dt>
                <dd class="col-sm-8">@(Model.CompanyName ?? "—")</dd>

                <dt class="col-sm-4 text-muted">Address</dt>
                <dd class="col-sm-8">@(Model.Address ?? "—")</dd>

                <dt class="col-sm-4 text-muted">Location</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.City) ? "—" : $"{Model.City}, {Model.State}")</dd>

                <dt class="col-sm-4 text-muted">Assigned</dt>
                <dd class="col-sm-8 text-primary fw-semibold">@(Model.AssignedTo ?? "Unassigned")</dd>
            </dl>
        </div>
    </div>

    <!-- Related Details & Navigation Tabs -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom p-0">
                <ul class="nav nav-tabs border-0" id="customerTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active px-4 py-3 fw-semibold small" id="opps-tab" data-bs-toggle="tab" data-bs-target="#opps" type="button" role="tab">
                            <i class="bi bi-briefcase me-1"></i> Opportunities (@Model.Opportunities.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-semibold small" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button" role="tab">
                            <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-semibold small" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button" role="tab">
                            <i class="bi bi-clock-history me-1"></i> Activities (@Model.Activities.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-semibold small" id="audit-tab" data-bs-toggle="tab" data-bs-target="#audit" type="button" role="tab">
                            <i class="bi bi-shield-check me-1"></i> Audit Trail
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-3">
                <div class="tab-content" id="customerTabsContent">
                    <!-- Opportunities Tab -->
                    <div class="tab-pane fade show active" id="opps" role="tabpanel">
                        @if (Model.Opportunities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Opportunity</th>
                                            <th>Stage</th>
                                            <th>Amount</th>
                                            <th>Prob %</th>
                                            <th>Close Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var o in Model.Opportunities)
                                        {
                                            <tr>
                                                <td class="fw-semibold small"><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId">@o.OpportunityName</a></td>
                                                <td><span class="badge @(o.Stage == "Won" ? "bg-success" : (o.Stage == "Lost" ? "bg-danger" : "bg-primary"))">@o.Stage</span></td>
                                                <td class="small fw-bold">@o.Amount.ToString("C0")</td>
                                                <td class="small">@o.Probability%</td>
                                                <td class="small text-muted">@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">No opportunities linked yet.</div>
                        }
                    </div>

                    <!-- Follow-Ups Tab -->
                    <div class="tab-pane fade" id="followups" role="tabpanel">
                        @if (Model.FollowUps.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in Model.FollowUps)
                                        {
                                            <tr>
                                                <td class="small fw-semibold">@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                                <td><span class="badge @(f.Status == "Completed" ? "bg-success" : (f.Status == "Missed" ? "bg-danger" : "bg-primary"))">@f.Status</span></td>
                                                <td class="small text-truncate" style="max-width: 250px;">@f.Remarks</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">No follow-ups recorded yet.</div>
                        }
                    </div>

                    <!-- Activities Tab -->
                    <div class="tab-pane fade" id="activities" role="tabpanel">
                        @if (Model.Activities.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var a in Model.Activities.OrderByDescending(x => x.ActivityDate))
                                {
                                    <li class="list-group-item px-0 py-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="fw-semibold text-dark small"><i class="bi bi-check2-circle text-primary me-1"></i>@a.Subject (@a.ActivityType)</div>
                                            <span class="text-muted small" style="font-size: 0.75rem;">@a.ActivityDate.ToString("g")</span>
                                        </div>
                                        <p class="text-muted small mb-0 mt-1">@a.Description</p>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">No activities logged yet.</div>
                        }
                    </div>

                    <!-- Audit Trail Tab -->
                    <div class="tab-pane fade" id="audit" role="tabpanel">
                        @if (auditLogs.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>User</th>
                                            <th>Action</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in auditLogs)
                                        {
                                            <tr class="small">
                                                <td class="text-muted">@log.CreatedDate.ToString("g")</td>
                                                <td class="fw-semibold">@log.UserId</td>
                                                <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                                <td class="text-truncate" style="max-width: 280px;">@log.Details</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">No audit records found for this customer.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
