@inject AcxiomCRM.Services.ICurrentUserService CurrentUser
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <div class="bg-dark text-white border-end" id="sidebar-wrapper" style="min-width: 250px; max-width: 250px; min-height: 100vh;">
                <div class="sidebar-heading px-4 py-3 border-bottom border-secondary d-flex align-items-center">
                    <i class="bi bi-diagram-3-fill text-primary fs-3 me-2"></i>
                    <div>
                        <span class="fs-5 fw-bold text-white tracking-wide">Acxiom<span class="text-primary">CRM</span></span>
                        <div class="small text-secondary" style="font-size: 0.72rem;">Enterprise Sales Cloud</div>
                    </div>
                </div>
                <div class="list-group list-group-flush my-2">
                    <a asp-controller="Dashboard" asp-action="Index" 
                       class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active bg-primary border-0" : "hover-dark")">
                        <i class="bi bi-speedometer2 me-3 fs-5"></i> Dashboard
                    </a>
                    <a asp-controller="Customers" asp-action="Index" 
                       class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active bg-primary border-0" : "hover-dark")">
                        <i class="bi bi-people-fill me-3 fs-5"></i> Customers
                    </a>
                    <a asp-controller="Leads" asp-action="Index" 
                       class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leads" ? "active bg-primary border-0" : "hover-dark")">
                        <i class="bi bi-funnel-fill me-3 fs-5"></i> Leads
                    </a>
                    <a asp-controller="Opportunities" asp-action="Index" 
                       class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Opportunities" ? "active bg-primary border-0" : "hover-dark")">
                        <i class="bi bi-briefcase-fill me-3 fs-5"></i> Opportunities
                    </a>
                    <a asp-controller="FollowUps" asp-action="Index" 
                       class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "FollowUps" ? "active bg-primary border-0" : "hover-dark")">
                        <i class="bi bi-calendar-check-fill me-3 fs-5"></i> Follow-Ups
                    </a>
                    <a asp-controller="Activities" asp-action="Index" 
                       class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Activities" ? "active bg-primary border-0" : "hover-dark")">
                        <i class="bi bi-clock-history me-3 fs-5"></i> Activities
                    </a>
                    <a asp-controller="Reports" asp-action="Index" 
                       class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active bg-primary border-0" : "hover-dark")">
                        <i class="bi bi-graph-up-arrow me-3 fs-5"></i> Reports
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="px-4 pt-3 pb-1 text-uppercase text-secondary small fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Administration</div>
                        <a asp-controller="AuditLogs" asp-action="Index" 
                           class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AuditLogs" ? "active bg-primary border-0" : "hover-dark")">
                            <i class="bi bi-shield-check me-3 fs-5"></i> Audit Logs
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Users" asp-action="Index" 
                           class="list-group-item list-group-item-action bg-dark text-light px-4 py-2.5 d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active bg-primary border-0" : "hover-dark")">
                            <i class="bi bi-person-gear me-3 fs-5"></i> Users & Roles
                        </a>
                    }
                </div>
            </div>

            <!-- Page Content -->
            <div id="page-content-wrapper" class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
                <!-- Top Navbar -->
                <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 py-2 shadow-sm">
                    <div class="container-fluid p-0">
                        <div class="d-flex align-items-center">
                            <span class="fs-6 fw-semibold text-secondary">
                                <i class="bi bi-building me-1"></i> AcxiomCRM Enterprise
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="text-end d-none d-md-block">
                                <div class="fw-bold text-dark small">@User.Identity?.Name</div>
                                <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : (User.IsInRole("Manager") ? "bg-primary" : "bg-success"))" style="font-size: 0.7rem;">
                                    @(User.IsInRole("Admin") ? "Administrator" : (User.IsInRole("Manager") ? "Sales Manager" : "Sales Executive"))
                                </span>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </div>
                    </div>
                </nav>

                <!-- Main Container -->
                <main role="main" class="container-fluid px-4 py-4 flex-grow-1">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="footer mt-auto py-2 bg-white border-top text-center text-muted small">
                    &copy; @DateTime.UtcNow.Year AcxiomCRM — Confidential Sales Management System. Role-Based Access Control Active.
                </footer>
            </div>
        </div>
    }
    else
    {
        <div class="min-vh-100 d-flex flex-column">
            <main role="main" class="flex-grow-1">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="container mt-3">
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="container mt-3">
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                }
                @RenderBody()
            </main>
            <footer class="footer py-3 bg-white border-top text-center text-muted small">
                &copy; @DateTime.UtcNow.Year AcxiomCRM — Enterprise Sales Platform
            </footer>
        </div>
    }

    <!-- jQuery, Bootstrap JS, and Unobtrusive Validation -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
