@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 border-0 shadow-sm">
                <div class="mb-3">
                    <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold text-dark">Access Restricted (403)</h3>
                <p class="text-muted mt-2">
                    You do not have the required permissions or role scope to view or modify this resource.
                </p>
                <div class="mt-4">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-house-door me-1"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
