@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activity Management";
    var currentType = (string?)ViewData["CurrentType"];
    var currentStatus = (string?)ViewData["CurrentStatus"];
    var currentSearch = (string?)ViewData["CurrentSearch"];
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-secondary me-2"></i>Activity History</h3>
        <p class="text-muted small mb-0">Calls, meetings, emails, and sales tasks logged</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <input type="text" name="search" class="form-control" placeholder="Search subject or description..." value="@currentSearch" />
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(currentType == "Call")">Call</option>
                    <option value="Meeting" selected="@(currentType == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(currentType == "Email")">Email</option>
                    <option value="Task" selected="@(currentType == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2 col-lg-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(currentStatus == "Completed")">Completed</option>
                    <option value="Scheduled" selected="@(currentStatus == "Scheduled")">Scheduled</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Pending</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentType) || !string.IsNullOrEmpty(currentStatus))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filter"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Type</th>
                        <th>Subject</th>
                        <th>Related Entity</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge @(item.ActivityType == "Meeting" ? "bg-primary" : (item.ActivityType == "Call" ? "bg-info text-dark" : (item.ActivityType == "Email" ? "bg-warning text-dark" : "bg-secondary")))">
                                        @item.ActivityType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark small">@item.Subject</div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 300px;">@item.Description</div>
                                    }
                                </td>
                                <td>
                                    @if (item.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="small fw-semibold text-decoration-none">
                                            <i class="bi bi-people me-1"></i>@item.Customer.CustomerName
                                        </a>
                                    }
                                    else if (item.Lead != null)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="small fw-semibold text-decoration-none">
                                            <i class="bi bi-funnel me-1"></i>@item.Lead.LeadName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="small text-muted">@item.ActivityDate.ToString("g")</td>
                                <td>
                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : (item.Status == "Scheduled" ? "bg-primary" : "bg-warning text-dark"))">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <form asp-action="Delete" asp-route-id="@item.ActivityId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Remove"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No activities recorded matching your criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
