@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h4 class="fw-bold mb-0 text-dark">Log Sales Interaction</h4>
        </div>

        <div class="card border-0 shadow-sm p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ActivityType" class="form-label fw-semibold small">Type <span class="text-danger">*</span></label>
                        <select asp-for="ActivityType" class="form-select" asp-items="ViewBag.Types"></select>
                        <span asp-validation-for="ActivityType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold small">Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select" asp-items="ViewBag.Statuses"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Subject" class="form-label fw-semibold small">Subject <span class="text-danger">*</span></label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Introductory discovery call or Technical evaluation meeting" />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label fw-semibold small">Customer</label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                            <option value="">-- None / Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label fw-semibold small">Lead</label>
                        <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                            <option value="">-- None / Select Lead --</option>
                        </select>
                        <span asp-validation-for="LeadId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small">Description & Minutes</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Key meeting takeaways, client objections, next steps..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold small">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                                <option value="">-- Assign Sales Executive --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger"></span>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Save Activity
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
