@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = $"Opportunity - {Model.OpportunityName}";
    var auditLogs = ViewBag.AuditLogs as IEnumerable<AcxiomCRM.Models.AuditLog> ?? Enumerable.Empty<AcxiomCRM.Models.AuditLog>();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
            <h3 class="fw-bold mb-0 text-dark">@Model.OpportunityName</h3>
            <span class="badge @(Model.Stage == "Won" ? "bg-success" : (Model.Stage == "Lost" ? "bg-danger" : "bg-primary"))">
                @Model.Stage
            </span>
        </div>
        <div class="text-muted small">Created on @Model.CreatedDate.ToString("MMMM dd, yyyy") | Status: <strong>@Model.Status</strong></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Opportunity
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Deal Metrics Summary Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 h-100">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-cash-coin text-success me-2"></i>Financial Terms</h5>
            <dl class="row mb-0 small">
                <dt class="col-sm-5 text-muted">Customer</dt>
                <dd class="col-sm-7 fw-semibold">
                    @if (Model.Customer != null)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.CustomerName</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </dd>

                <dt class="col-sm-5 text-muted">Deal Amount</dt>
                <dd class="col-sm-7 fw-bold text-dark fs-6">@Model.Amount.ToString("C2")</dd>

                <dt class="col-sm-5 text-muted">Probability</dt>
                <dd class="col-sm-7 fw-semibold">@Model.Probability%</dd>

                <dt class="col-sm-5 text-muted">Weighted Value</dt>
                <dd class="col-sm-7 fw-bold text-primary fs-6">@Model.WeightedAmount.ToString("C2")</dd>

                <dt class="col-sm-5 text-muted">Close Target</dt>
                <dd class="col-sm-7 @(Model.ExpectedCloseDate < DateTime.Today && Model.Status == "Open" ? "text-danger fw-bold" : "")">
                    @Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")
                </dd>

                <dt class="col-sm-5 text-muted">Assigned To</dt>
                <dd class="col-sm-7 text-primary fw-semibold">@(Model.AssignedTo ?? "Unassigned")</dd>

                @if (Model.Lead != null)
                {
                    <dt class="col-sm-5 text-muted">Source Lead</dt>
                    <dd class="col-sm-7">
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.Lead.LeadId">@Model.Lead.LeadName</a>
                    </dd>
                }
            </dl>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="mt-3 pt-3 border-top">
                    <span class="text-muted small fw-semibold">Notes:</span>
                    <p class="small text-secondary mt-1 mb-0">@Model.Notes</p>
                </div>
            }
        </div>
    </div>

    <!-- Related Follow-Ups and Audit Trail -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom p-0">
                <ul class="nav nav-tabs border-0" id="oppTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active px-4 py-3 fw-semibold small" id="opp-followups-tab" data-bs-toggle="tab" data-bs-target="#opp-followups" type="button" role="tab">
                            <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-4 py-3 fw-semibold small" id="opp-audit-tab" data-bs-toggle="tab" data-bs-target="#opp-audit" type="button" role="tab">
                            <i class="bi bi-shield-check me-1"></i> Audit Trail
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-3">
                <div class="tab-content" id="oppTabsContent">
                    <!-- Follow-ups -->
                    <div class="tab-pane fade show active" id="opp-followups" role="tabpanel">
                        @if (Model.FollowUps.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in Model.FollowUps)
                                        {
                                            <tr>
                                                <td class="small fw-semibold">@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                                <td><span class="badge @(f.Status == "Completed" ? "bg-success" : (f.Status == "Missed" ? "bg-danger" : "bg-primary"))">@f.Status</span></td>
                                                <td class="small text-truncate" style="max-width: 250px;">@f.Remarks</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">No follow-ups recorded for this deal.</div>
                        }
                    </div>

                    <!-- Audit Trail -->
                    <div class="tab-pane fade" id="opp-audit" role="tabpanel">
                        @if (auditLogs.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>User</th>
                                            <th>Action</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in auditLogs)
                                        {
                                            <tr class="small">
                                                <td class="text-muted">@log.CreatedDate.ToString("g")</td>
                                                <td class="fw-semibold">@log.UserId</td>
                                                <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                                <td class="text-truncate" style="max-width: 280px;">@log.Details</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">No audit records found for this opportunity.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
