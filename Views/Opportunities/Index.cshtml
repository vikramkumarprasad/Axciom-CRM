@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Management";
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var currentSearch = (string?)ViewData["CurrentSearch"];
    var currentStage = (string?)ViewData["CurrentStage"];
    var currentStatus = (string?)ViewData["CurrentStatus"];
    var totalPipeline = (decimal)(ViewBag.TotalPipeline ?? 0m);
    var totalWeighted = (decimal)(ViewBag.TotalWeighted ?? 0m);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-briefcase-fill text-primary me-2"></i>Sales Opportunities</h3>
        <p class="text-muted small mb-0">Total opportunities: <strong>@totalCount</strong></p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> New Opportunity
        </a>
    </div>
</div>

<!-- Financial Summary Widgets -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-success">
            <div class="text-muted small fw-semibold text-uppercase">Total Active Pipeline</div>
            <div class="h4 fw-bold text-success mb-0">@totalPipeline.ToString("C0")</div>
            <div class="small text-muted mt-1">Unweighted pipeline total</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-primary">
            <div class="text-muted small fw-semibold text-uppercase">Weighted Forecast</div>
            <div class="h4 fw-bold text-primary mb-0">@totalWeighted.ToString("C0")</div>
            <div class="small text-muted mt-1">Calculated via (Amount &times; Probability) / 100</div>
        </div>
    </div>
    <div class="col-md-12 col-lg-4">
        <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-info">
            <div class="text-muted small fw-semibold text-uppercase">Active Deals Count</div>
            <div class="h4 fw-bold text-dark mb-0">@totalCount</div>
            <div class="small text-muted mt-1">Opportunities currently tracked</div>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search opportunity or customer..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="stage" class="form-select">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(currentStage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(currentStage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(currentStage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(currentStage == "Won")">Won</option>
                    <option value="Lost" selected="@(currentStage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2 col-lg-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(currentStatus == "Open")">Open</option>
                    <option value="Won" selected="@(currentStatus == "Won")">Won</option>
                    <option value="Lost" selected="@(currentStatus == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentStage) || !string.IsNullOrEmpty(currentStatus))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filter"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Opportunity</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Close Date</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold text-dark"><a asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none">@item.OpportunityName</a></div>
                                </td>
                                <td>
                                    @if (item.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="small text-decoration-none fw-semibold">
                                            @item.Customer.CustomerName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(item.Stage == "Won" ? "bg-success" : (item.Stage == "Lost" ? "bg-danger" : (item.Stage == "Negotiation" ? "bg-warning text-dark" : "bg-primary")))">
                                        @item.Stage
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">@item.Amount.ToString("C0")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                            <div class="progress-bar @(item.Probability >= 70 ? "bg-success" : (item.Probability >= 40 ? "bg-primary" : "bg-warning"))" style="width: @item.Probability%"></div>
                                        </div>
                                        <span class="small fw-semibold">@item.Probability%</span>
                                    </div>
                                </td>
                                <td class="fw-semibold text-primary">@item.WeightedAmount.ToString("C0")</td>
                                <td class="small @(item.ExpectedCloseDate < DateTime.Today && item.Status == "Open" ? "text-danger fw-bold" : "text-muted")">
                                    @item.ExpectedCloseDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteOpp-@item.OpportunityId">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteOpp-@item.OpportunityId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Confirm Delete</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to delete opportunity <strong>@item.OpportunityName</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No opportunities found matching your criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2 px-3 border-top">
            <span class="small text-muted">Page @currentPage of @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
