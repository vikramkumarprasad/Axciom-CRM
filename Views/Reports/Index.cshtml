@model AcxiomCRM.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "CRM Reports & Intelligence";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Reports & Analytics Center</h3>
        <p class="text-muted small mb-0">Pipeline forecasting, conversion ratios, and sales productivity reports</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
    </div>
</div>

<!-- Report Navigation Tabs & Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Select Report</label>
                <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="Pipeline" selected="@(Model.ReportType == "Pipeline")">Sales Pipeline & Forecast</option>
                    <option value="Customer" selected="@(Model.ReportType == "Customer")">Customer Directory Report</option>
                    <option value="Lead" selected="@(Model.ReportType == "Lead")">Lead Acquisition Report</option>
                    <option value="Opportunity" selected="@(Model.ReportType == "Opportunity")">Opportunity Ledger</option>
                    <option value="FollowUp" selected="@(Model.ReportType == "FollowUp")">Follow-Up Execution Report</option>
                    <option value="Conversion" selected="@(Model.ReportType == "Conversion")">Lead Conversion Analysis</option>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <option value="UserActivity" selected="@(Model.ReportType == "UserActivity")">Sales Team Activity Report</option>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <option value="Audit" selected="@(Model.ReportType == "Audit")">System Audit & Compliance</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Date Range</label>
                <div class="input-group input-group-sm">
                    <input type="date" name="startDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" placeholder="From" />
                    <input type="date" name="endDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" placeholder="To" />
                </div>
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Sales Owner</label>
                    <select name="owner" class="form-select form-select-sm" asp-items="ViewBag.Users">
                        <option value="">All Team Members</option>
                    </select>
                </div>
            }

            <div class="col-md-2 mt-auto">
                <button type="submit" class="btn btn-primary btn-sm w-100">Apply Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Report Content Body -->
@if (Model.ReportType == "Pipeline")
{
    <!-- Pipeline Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-success">
                <div class="text-muted small fw-semibold text-uppercase">Total Open Pipeline</div>
                <div class="h4 fw-bold text-success mb-0">@Model.TotalPipelineValue.ToString("C0")</div>
                <div class="small text-muted mt-1">@Model.TotalOpenDeals open opportunities</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-primary">
                <div class="text-muted small fw-semibold text-uppercase">Weighted Forecast</div>
                <div class="h4 fw-bold text-primary mb-0">@Model.TotalWeightedValue.ToString("C0")</div>
                <div class="small text-muted mt-1">(Amount &times; Probability)</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-info">
                <div class="text-muted small fw-semibold text-uppercase">Closed Won Deals</div>
                <div class="h4 fw-bold text-dark mb-0">@Model.TotalWonValue.ToString("C0")</div>
                <div class="small text-muted mt-1">@Model.TotalWonDeals deals converted</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm bg-white border-start border-4 border-warning">
                <div class="text-muted small fw-semibold text-uppercase">Win Rate Ratio</div>
                <div class="h4 fw-bold text-dark mb-0">@Model.WinRatePercentage.ToString("F1")%</div>
                <div class="small text-muted mt-1">Won vs. Total registered</div>
            </div>
        </div>
    </div>

    <!-- Stage-wise Breakdown Table -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel me-1"></i> Stage-Wise Pipeline Distribution</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Pipeline Stage</th>
                            <th>Active Deals Count</th>
                            <th>Nominal Amount</th>
                            <th>Weighted Amount</th>
                            <th>Forecast Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stage in Model.StageSummaries)
                        {
                            var share = Model.TotalPipelineValue > 0 ? (stage.TotalAmount * 100.0m / Model.TotalPipelineValue) : 0;
                            <tr>
                                <td class="ps-3 fw-bold small">@stage.Stage</td>
                                <td>@stage.Count</td>
                                <td class="fw-bold">@stage.TotalAmount.ToString("C0")</td>
                                <td class="text-primary fw-semibold">@stage.WeightedAmount.ToString("C0")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 80px;">
                                            <div class="progress-bar bg-primary" style="width: @share%"></div>
                                        </div>
                                        <span class="small">@share.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Owner-wise Breakdown Table -->
    @if (Model.OwnerSummaries.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-people me-1"></i> Owner-Wise Pipeline Contribution</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Sales Owner</th>
                                <th>Assigned Deals</th>
                                <th>Open Pipeline Value</th>
                                <th>Won Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var owner in Model.OwnerSummaries)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold small text-dark">@owner.OwnerName</td>
                                    <td>@owner.OpportunityCount</td>
                                    <td class="fw-bold text-primary">@owner.TotalPipeline.ToString("C0")</td>
                                    <td class="fw-bold text-success">@owner.WonPipeline.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else if (Model.ReportType == "Customer")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0 text-dark">Customer Portfolio Report (@Model.Customers.Count records)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Code</th>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Customers)
                        {
                            <tr>
                                <td class="ps-3 fw-bold small text-primary">@c.CustomerCode</td>
                                <td class="fw-semibold">@c.CustomerName</td>
                                <td class="small">@c.Email</td>
                                <td class="small">@c.Phone</td>
                                <td class="small">@(c.CompanyName ?? "—")</td>
                                <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                                <td class="small text-muted">@c.CreatedDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Model.ReportType == "Lead")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0 text-dark">Lead Acquisition & Tracking Report (@Model.Leads.Count records)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Code</th>
                            <th>Lead Name</th>
                            <th>Company</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Expected Value</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Leads)
                        {
                            <tr>
                                <td class="ps-3 fw-bold small text-info">@l.LeadCode</td>
                                <td class="fw-semibold">@l.LeadName</td>
                                <td class="small">@(l.CompanyName ?? "—")</td>
                                <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                                <td><span class="badge @(l.Status == "Converted" ? "bg-success" : (l.Status == "Qualified" ? "bg-primary" : "bg-warning text-dark"))">@l.Status</span></td>
                                <td class="fw-bold">@l.ExpectedValue.ToString("C0")</td>
                                <td class="small text-muted">@l.CreatedDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Model.ReportType == "Opportunity")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0 text-dark">Opportunities Ledger (@Model.Opportunities.Count records)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Opportunity Name</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Expected Close Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Opportunities)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@o.OpportunityName</td>
                                <td>@(o.Customer?.CustomerName ?? "—")</td>
                                <td><span class="badge @(o.Stage == "Won" ? "bg-success" : (o.Stage == "Lost" ? "bg-danger" : "bg-primary"))">@o.Stage</span></td>
                                <td class="fw-bold">@o.Amount.ToString("C0")</td>
                                <td>@o.Probability%</td>
                                <td class="small text-muted">@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Model.ReportType == "FollowUp")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0 text-dark">Follow-Up Execution Audit (@Model.FollowUps.Count records)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Type</th>
                            <th>Target Entity</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold small">@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                <td class="small">@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "—")</td>
                                <td><span class="badge @(f.Status == "Completed" ? "bg-success" : (f.Status == "Missed" ? "bg-danger" : "bg-primary"))">@f.Status</span></td>
                                <td class="small text-truncate" style="max-width: 300px;">@f.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Model.ReportType == "Conversion")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0 text-dark">Lead Conversion Analysis by Source Channel</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Acquisition Channel</th>
                            <th>Total Leads Captured</th>
                            <th>Successfully Converted</th>
                            <th>Conversion Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.ConversionSummaries)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold small">@c.Source</td>
                                <td>@c.TotalLeads</td>
                                <td class="fw-bold text-success">@c.ConvertedCount</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 100px;">
                                            <div class="progress-bar bg-success" style="width: @c.ConversionRate%"></div>
                                        </div>
                                        <span class="small fw-bold">@c.ConversionRate.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Model.ReportType == "UserActivity")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0 text-dark">Team Productivity & Activity Volume</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Sales Representative</th>
                            <th>Logged Activities</th>
                            <th>Follow-Ups Scheduled</th>
                            <th>Security & Audit Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.UserActivitySummaries)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold small text-dark">@u.UserName</td>
                                <td class="fw-bold">@u.ActivityCount</td>
                                <td class="fw-bold">@u.FollowUpCount</td>
                                <td class="text-muted">@u.AuditEventsCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Model.ReportType == "Audit")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0 text-dark">Compliance & Security Events Log</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.AuditLogs)
                        {
                            <tr class="small">
                                <td class="ps-3 text-muted">@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="fw-semibold">@a.UserId</td>
                                <td><span class="badge bg-light text-dark border">@a.Action</span></td>
                                <td>@a.EntityName</td>
                                <td class="text-truncate" style="max-width: 350px;">@a.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
