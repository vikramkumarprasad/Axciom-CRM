@inject AcxiomCRM.Services.ICurrentUserService CurrentUser
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AcxiomCRM Enterprise — Next-Gen Sales Execution & Revenue Governance</title>
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom Landing CSS -->
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="landing-body position-relative">

    <!-- Atmospheric Glow & Subtle Grid Background -->
    <div class="landing-hero-backdrop"></div>
    <div class="landing-grid-pattern"></div>

    <!-- Sticky Navigation Bar -->
    <nav class="navbar navbar-expand-lg landing-nav py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center text-dark text-decoration-none" href="/">
                <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 38px; height: 38px;">
                    <i class="bi bi-diagram-3-fill fs-5"></i>
                </div>
                <div>
                    <span class="fs-5 fw-bold font-heading text-dark" style="letter-spacing: -0.02em;">Acxiom<span class="text-primary">CRM</span></span>
                    <span class="badge bg-light text-secondary border ms-1 font-monospace" style="font-size: 0.65rem;">ENTERPRISE</span>
                </div>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#landingNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="landingNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="#preview">Product Tour</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="#capabilities">Capabilities</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="#calculator">ROI Engine</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="#security">Security & Governance</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="#demo">Live Roles</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-premium-primary btn-sm px-3">
                            <i class="bi bi-speedometer2"></i> Enter Workspace
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-premium-secondary btn-sm px-3">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </a>
                        <button type="button" class="btn btn-premium-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#demoModal">
                            <i class="bi bi-play-circle-fill"></i> Launch Demo
                        </button>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="position-relative pt-5 pb-4 overflow-hidden">
        <div class="container text-center pt-3">
            
            <!-- Release Pill Badge -->
            <div class="mb-3">
                <span class="pill-badge shadow-sm">
                    <span class="pulse-dot"></span>
                    <span>AcxiomCRM v2.4 Enterprise</span>
                    <span class="text-muted fw-normal">|</span>
                    <span class="fw-semibold text-dark">Strict SRS 17.20 Standard</span>
                </span>
            </div>

            <!-- Primary Headline -->
            <h1 class="hero-heading mb-3">
                The Revenue Engine for <br class="d-none d-md-block" />
                <span class="text-gradient-primary">High-Velocity Sales Teams</span>
            </h1>

            <!-- Subtitle -->
            <p class="hero-subtitle mb-4">
                Unify your complete commercial lifecycle. From 360° customer intelligence and automated lead qualification to weighted stage forecasting and an immutable compliance audit trail.
            </p>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-center align-items-center gap-3 flex-wrap mb-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-premium-primary">
                    <i class="bi bi-rocket-takeoff-fill"></i> Get Started Free
                </a>
                <a href="#preview" class="btn btn-premium-secondary">
                    <i class="bi bi-eye-fill"></i> Explore Live Workspace
                </a>
            </div>

            <!-- Trust Indicator Badges -->
            <div class="d-flex justify-content-center align-items-center gap-4 flex-wrap text-muted small mt-2">
                <span class="d-flex align-items-center gap-1">
                    <i class="bi bi-shield-lock-fill text-success"></i> PBKDF2 Identity Hash
                </span>
                <span class="d-flex align-items-center gap-1">
                    <i class="bi bi-diagram-2-fill text-primary"></i> 3-Tier Role Scoping
                </span>
                <span class="d-flex align-items-center gap-1">
                    <i class="bi bi-clock-history text-indigo" style="color: #6366f1;"></i> Append-Only Audit Trail
                </span>
                <span class="d-flex align-items-center gap-1">
                    <i class="bi bi-check2-circle text-info" style="color: #0284c7;"></i> 14 Acceptance Criteria Verified
                </span>
            </div>

            <!-- Hero Mockup Frame (Interactive Live Showcase) -->
            <div class="app-mockup-wrapper text-start" id="preview">
                
                <!-- Window Controls and Tab Buttons -->
                <div class="mockup-titlebar">
                    <div class="d-flex align-items-center gap-3">
                        <div class="window-dots">
                            <span class="window-dot dot-red"></span>
                            <span class="window-dot dot-yellow"></span>
                            <span class="window-dot dot-green"></span>
                        </div>
                        <span class="small text-muted font-monospace d-none d-sm-inline" style="font-size: 0.78rem;">
                            <i class="bi bi-lock-fill text-success me-1"></i> https://app.acxiomcrm.com/live-workspace
                        </span>
                    </div>

                    <!-- Interactive Tabs Navigation -->
                    <div class="d-flex gap-1">
                        <button type="button" class="mockup-tab-btn active" data-target="tab-pipeline">
                            <i class="bi bi-graph-up me-1"></i> Pipeline Forecast
                        </button>
                        <button type="button" class="mockup-tab-btn" data-target="tab-lead-wizard">
                            <i class="bi bi-funnel me-1"></i> Lead Conversion
                        </button>
                        <button type="button" class="mockup-tab-btn" data-target="tab-customer360">
                            <i class="bi bi-person-badge me-1"></i> Customer 360°
                        </button>
                        <button type="button" class="mockup-tab-btn" data-target="tab-audit">
                            <i class="bi bi-shield-check me-1"></i> Audit Trail
                        </button>
                    </div>
                </div>

                <!-- Mockup Body Content -->
                <div class="mockup-body">

                    <!-- TAB 1: Pipeline Forecast -->
                    <div class="mockup-pane" id="tab-pipeline">
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6 col-md-3">
                                <div class="bg-white p-3 rounded-3 border shadow-sm">
                                    <div class="text-muted small fw-medium">Active Pipeline Value</div>
                                    <div class="fs-4 fw-bold text-dark mt-1">$1,425,000</div>
                                    <span class="badge bg-success-subtle text-success mt-1" style="font-size: 0.7rem;">+18.4% this quarter</span>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="bg-white p-3 rounded-3 border shadow-sm">
                                    <div class="text-muted small fw-medium">Weighted Forecast</div>
                                    <div class="fs-4 fw-bold text-primary mt-1">$864,200</div>
                                    <span class="badge bg-primary-subtle text-primary mt-1" style="font-size: 0.7rem;">Expected close 30d</span>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="bg-white p-3 rounded-3 border shadow-sm">
                                    <div class="text-muted small fw-medium">Closed-Won Deals</div>
                                    <div class="fs-4 fw-bold text-success mt-1">$520,000</div>
                                    <span class="badge bg-success-subtle text-success mt-1" style="font-size: 0.7rem;">34 Deals Closed</span>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="bg-white p-3 rounded-3 border shadow-sm">
                                    <div class="text-muted small fw-medium">Stage Velocity</div>
                                    <div class="fs-4 fw-bold text-dark mt-1">14.2 Days</div>
                                    <span class="badge bg-secondary-subtle text-secondary mt-1" style="font-size: 0.7rem;">Avg lead-to-close</span>
                                </div>
                            </div>
                        </div>

                        <!-- Stage Progress Visualizer -->
                        <div class="bg-white p-3 rounded-3 border shadow-sm mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold small text-dark"><i class="bi bi-funnel-fill text-primary me-1"></i> Stage Distribution & Probability Alignment</span>
                                <span class="badge bg-light text-dark border">Auto-Synchronized</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-info" style="width: 25%" title="Qualification (20%)"></div>
                                <div class="progress-bar bg-primary" style="width: 35%" title="Proposal (50%)"></div>
                                <div class="progress-bar bg-warning" style="width: 20%" title="Negotiation (80%)"></div>
                                <div class="progress-bar bg-success" style="width: 20%" title="Won (100%)"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mt-2" style="font-size: 0.75rem;">
                                <span><span class="badge bg-info p-1 me-1"> </span> Qualification ($350k)</span>
                                <span><span class="badge bg-primary p-1 me-1"> </span> Proposal ($520k)</span>
                                <span><span class="badge bg-warning p-1 me-1"> </span> Negotiation ($280k)</span>
                                <span><span class="badge bg-success p-1 me-1"> </span> Closed-Won ($520k)</span>
                            </div>
                        </div>

                        <!-- Mini Opportunity List -->
                        <div class="bg-white rounded-3 border shadow-sm p-0 overflow-hidden">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.82rem;">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Deal Name</th>
                                            <th>Account</th>
                                            <th>Stage</th>
                                            <th>Probability</th>
                                            <th>Amount</th>
                                            <th>Forecast</th>
                                            <th>Rep</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="fw-semibold text-dark">Enterprise ERP Integration</td>
                                            <td>Nexus Retail Group</td>
                                            <td><span class="badge bg-warning text-dark">Negotiation</span></td>
                                            <td>80%</td>
                                            <td class="fw-bold">$120,000</td>
                                            <td class="text-primary fw-semibold">$96,000</td>
                                            <td>Alex Johnson</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold text-dark">Cloud Migration Phase 2</td>
                                            <td>Apex Global Systems</td>
                                            <td><span class="badge bg-primary">Proposal</span></td>
                                            <td>50%</td>
                                            <td class="fw-bold">$85,000</td>
                                            <td class="text-primary fw-semibold">$42,500</td>
                                            <td>Alex Johnson</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold text-dark">Annual SaaS License Tier A</td>
                                            <td>Omni Logistics</td>
                                            <td><span class="badge bg-success">Closed-Won</span></td>
                                            <td>100%</td>
                                            <td class="fw-bold">$160,000</td>
                                            <td class="text-success fw-semibold">$160,000</td>
                                            <td>Sarah Connor</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: Lead Conversion Wizard -->
                    <div class="mockup-pane d-none" id="tab-lead-wizard">
                        <div class="bg-white p-4 rounded-3 border shadow-sm">
                            <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                                <div>
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-magic text-primary me-2"></i>One-Click Lead Conversion Wizard</h6>
                                    <span class="text-muted small">Transforms qualified prospects into Customer Accounts and Sales Opportunities seamlessly.</span>
                                </div>
                                <span class="badge bg-success text-white"><i class="bi bi-check-circle-fill me-1"></i> Qualified Prospect</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Prospect Details</div>
                                        <div class="fw-bold text-dark mt-1">David Vance</div>
                                        <div class="small text-muted">AeroTech Aerospace Ltd</div>
                                        <div class="small text-muted font-monospace mt-1">david.v@aerotech.com</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Automated Action 1</div>
                                        <div class="fw-bold text-success mt-1"><i class="bi bi-building-add me-1"></i> New Customer Record</div>
                                        <div class="small text-muted">Generates code CUST-009 with duplicate prevention checks</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Automated Action 2</div>
                                        <div class="fw-bold text-primary mt-1"><i class="bi bi-briefcase-fill me-1"></i> Initial Opportunity</div>
                                        <div class="small text-muted">Opens $95,000 deal at Qualification stage automatically</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 p-3 rounded-3 bg-primary-subtle border border-primary-subtle d-flex justify-content-between align-items-center">
                                <div class="small text-primary">
                                    <i class="bi bi-info-circle-fill me-1"></i> Leads status automatically updates to <strong>Converted</strong>. Conversion links are archived for audit compliance.
                                </div>
                                <button type="button" class="btn btn-primary btn-sm px-3" onclick="alert('Simulation: In the real app, this creates both records instantaneously!');">
                                    Simulate Conversion
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: Customer 360 -->
                    <div class="mockup-pane d-none" id="tab-customer360">
                        <div class="bg-white p-4 rounded-3 border shadow-sm">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge bg-primary-subtle text-primary mb-1">CUST-001</span>
                                    <h5 class="fw-bold text-dark mb-0">Nexus Enterprise Solutions</h5>
                                    <p class="text-muted small mb-0">contact@nexus.com • +1-555-0192 • San Francisco, CA</p>
                                </div>
                                <span class="badge bg-success">Active Account</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="border rounded-3 p-3 bg-light">
                                        <span class="text-muted small fw-bold">Commercial Summary</span>
                                        <div class="mt-2 text-dark small"><strong>Total Opportunities:</strong> 2 ($240,000)</div>
                                        <div class="text-dark small"><strong>Completed Follow-ups:</strong> 8</div>
                                        <div class="text-dark small"><strong>Assigned Lead Rep:</strong> Alex Johnson</div>
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="border rounded-3 p-3">
                                        <span class="text-muted small fw-bold mb-2 d-block">Integrated Activity Timeline</span>
                                        <div class="d-flex gap-2 mb-2 pb-2 border-bottom align-items-center">
                                            <span class="badge bg-primary p-2"><i class="bi bi-telephone-fill"></i></span>
                                            <div class="small flex-grow-1">
                                                <strong>Call Logged:</strong> Executive review of Q4 cloud modernization requirements.
                                                <div class="text-muted" style="font-size: 0.7rem;">Today at 10:30 AM by Alex Johnson</div>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <span class="badge bg-success p-2"><i class="bi bi-calendar-check-fill"></i></span>
                                            <div class="small flex-grow-1">
                                                <strong>Follow-Up Completed:</strong> Contract review with Chief Information Officer.
                                                <div class="text-muted" style="font-size: 0.7rem;">Yesterday at 2:15 PM</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 4: Audit Trail -->
                    <div class="mockup-pane d-none" id="tab-audit">
                        <div class="bg-white rounded-3 border shadow-sm p-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="fw-bold small text-dark"><i class="bi bi-shield-check text-primary me-2"></i>Append-Only Immutable Compliance Ledger</div>
                                <span class="badge bg-secondary">System Ledger Verified</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0 font-monospace" style="font-size: 0.8rem;">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Timestamp (UTC)</th>
                                            <th>User</th>
                                            <th>Action</th>
                                            <th>Entity</th>
                                            <th>Record ID</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="text-muted">12-Oct-2026 12:15:30</td>
                                            <td>admin@acxiom.com</td>
                                            <td><span class="badge bg-primary">Create</span></td>
                                            <td>Customer</td>
                                            <td>CUST-008</td>
                                            <td>Created customer Acme Corp</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">12-Oct-2026 12:14:10</td>
                                            <td>sales@acxiom.com</td>
                                            <td><span class="badge bg-warning text-dark">Convert</span></td>
                                            <td>Lead</td>
                                            <td>LEAD-004</td>
                                            <td>Converted lead to Customer CUST-007</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">12-Oct-2026 12:10:02</td>
                                            <td>manager@acxiom.com</td>
                                            <td><span class="badge bg-info">Update</span></td>
                                            <td>Opportunity</td>
                                            <td>OPP-002</td>
                                            <td>Stage: Proposal -> Negotiation</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">12-Oct-2026 12:00:45</td>
                                            <td>sales@acxiom.com</td>
                                            <td><span class="badge bg-success">Login</span></td>
                                            <td>Auth</td>
                                            <td>—</td>
                                            <td>Successful session authentication</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </header>

    <!-- Key Metrics Strip -->
    <section class="stats-strip">
        <div class="container">
            <div class="row g-4 justify-content-center">
                <div class="col-6 col-md-3">
                    <div class="stat-item">
                        <div class="stat-number text-primary">$14.8M+</div>
                        <div class="stat-label">Pipeline Value Governed</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-item">
                        <div class="stat-number text-success">99.99%</div>
                        <div class="stat-label">System Availability SLA</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-item">
                        <div class="stat-number text-dark">3.4x</div>
                        <div class="stat-label">Faster Deal Cycle Velocity</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-item">
                        <div class="stat-number text-indigo" style="color: #4f46e5;">100%</div>
                        <div class="stat-label">Compliance Audit Integrity</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Capabilities Matrix -->
    <section class="py-5 bg-light" id="capabilities">
        <div class="container py-4">
            
            <div class="text-center mb-5">
                <span class="pill-badge mb-2">Architectural Capabilities</span>
                <h2 class="fw-bold text-dark fs-1" style="letter-spacing: -0.03em;">Engineered for High-Stakes B2B Sales</h2>
                <p class="text-muted mx-auto" style="max-width: 620px;">
                    Every capability is constructed to enforce disciplined sales workflows, eliminate data leaks, and ensure executive compliance.
                </p>
            </div>

            <div class="row g-4">
                
                <!-- 1. Customer 360 -->
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon-box icon-blue">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <h3 class="feature-title">Customer 360° Intelligence</h3>
                        <p class="feature-description">
                            Holistic account management linking deals, communications, scheduled follow-ups, and transaction histories in one authoritative view.
                        </p>
                        <span class="feature-tag">Duplicate Detection Active</span>
                    </div>
                </div>

                <!-- 2. Lead Qualification Wizard -->
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon-box icon-emerald">
                            <i class="bi bi-funnel-fill"></i>
                        </div>
                        <h3 class="feature-title">Lead Qualification & Conversion</h3>
                        <p class="feature-description">
                            Structured prospect lifecycle from qualification to automated dual-record conversion, spawning customer profiles and opportunities instantaneously.
                        </p>
                        <span class="feature-tag">1-Click Conversion Wizard</span>
                    </div>
                </div>

                <!-- 3. Weighted Opportunity Pipeline -->
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon-box icon-purple">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>
                        <h3 class="feature-title">Weighted Revenue Pipeline</h3>
                        <p class="feature-description">
                            Real-time stage progression across Qualification, Proposal, and Negotiation with synchronized win probabilities and in-memory forecast models.
                        </p>
                        <span class="feature-tag">Amount &gt; 0 Enforced</span>
                    </div>
                </div>

                <!-- 4. Follow-Ups & Activity Logging -->
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon-box icon-amber">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                        <h3 class="feature-title">Proactive Follow-Up Engine</h3>
                        <p class="feature-description">
