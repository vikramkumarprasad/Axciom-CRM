@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var currentUser = (string?)ViewData["CurrentUser"];
    var currentEntity = (string?)ViewData["CurrentEntity"];
    var currentAction = (string?)ViewData["CurrentAction"];
    var currentFromDate = (string?)ViewData["CurrentFromDate"];
    var currentToDate = (string?)ViewData["CurrentToDate"];
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-check text-primary me-2"></i>Security & Compliance Audit Trail</h3>
        <p class="text-muted small mb-0">Append-only immutable record of all authentication, data mutations, and security events</p>
    </div>
    <span class="badge bg-secondary">Total Logged Events: @totalCount</span>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="user" class="form-control form-control-sm" placeholder="Filter by User / Email..." value="@currentUser" />
            </div>
            <div class="col-md-2">
                <select name="entity" class="form-select form-select-sm" asp-items="ViewBag.Entities">
                    <option value="">All Entities</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="action" class="form-select form-select-sm" asp-items="ViewBag.Actions">
                    <option value="">All Actions</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@currentFromDate" title="From Date" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" class="form-control form-control-sm" value="@currentToDate" title="To Date" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(currentUser) || !string.IsNullOrEmpty(currentEntity) || !string.IsNullOrEmpty(currentAction))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Audit Log Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace" style="font-size: 0.85rem;">
                <thead class="font-sans-serif">
                    <tr>
                        <th class="ps-3">Timestamp (UTC)</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Record ID</th>
                        <th>Details</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="fw-semibold text-dark">@(log.UserId ?? "System")</td>
                                <td>
                                    <span class="badge @(log.Action.Contains("Delete") ? "bg-danger" : (log.Action.Contains("Create") ? "bg-success" : (log.Action.Contains("Login") ? "bg-info text-dark" : "bg-primary")))">
                                        @log.Action
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@log.EntityName</span></td>
                                <td class="text-secondary">@(log.RecordId ?? "—")</td>
                                <td style="max-width: 320px;">
                                    <div class="text-truncate" title="@log.Details">@(log.Details ?? "—")</div>
                                    @if (!string.IsNullOrEmpty(log.OldValue) || !string.IsNullOrEmpty(log.NewValue))
                                    {
                                        <div class="text-muted" style="font-size: 0.725rem;">
                                            @if (!string.IsNullOrEmpty(log.OldValue))
                                            {
                                                <span>Old: @log.OldValue </span>
                                            }
                                            @if (!string.IsNullOrEmpty(log.NewValue))
                                            {
                                                <span class="text-primary">New: @log.NewValue</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="text-muted small">@(log.IpAddress ?? "—")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted font-sans-serif">
                                <i class="bi bi-shield-slash fs-3 d-block mb-2"></i>
                                No audit log records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2 px-3 border-top">
            <span class="small text-muted">Page @currentPage of @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-user="@currentUser" asp-route-entity="@currentEntity" asp-route-action="@currentAction">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-user="@currentUser" asp-route-entity="@currentEntity" asp-route-action="@currentAction">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-user="@currentUser" asp-route-entity="@currentEntity" asp-route-action="@currentAction">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
