@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var currentSearch = (string?)ViewData["CurrentSearch"];
    var currentStatus = (string?)ViewData["CurrentStatus"];
    var currentSource = (string?)ViewData["CurrentSource"];
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel-fill text-info me-2"></i>Leads Pipeline</h3>
        <p class="text-muted small mb-0">Total prospective leads: <strong>@totalCount</strong></p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Capture Lead
        </a>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search lead name, company, code..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(currentStatus == "New")">New</option>
                    <option value="Contacted" selected="@(currentStatus == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(currentStatus == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(currentStatus == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(currentStatus == "Converted")">Converted</option>
                    <option value="Lost" selected="@(currentStatus == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2 col-lg-2">
                <select name="source" class="form-select">
                    <option value="">All Sources</option>
                    <option value="Website" selected="@(currentSource == "Website")">Website</option>
                    <option value="Referral" selected="@(currentSource == "Referral")">Referral</option>
                    <option value="Campaign" selected="@(currentSource == "Campaign")">Campaign</option>
                    <option value="Cold Call" selected="@(currentSource == "Cold Call")">Cold Call</option>
                    <option value="Partner" selected="@(currentSource == "Partner")">Partner</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentStatus) || !string.IsNullOrEmpty(currentSource))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filter"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Code</th>
                        <th>Lead Name</th>
                        <th>Contact</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Expected Value</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-info small">@item.LeadCode</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.LeadName</div>
                                    <div class="small text-muted">@(item.CompanyName ?? "Individual")</div>
                                </td>
                                <td>
                                    <div class="small"><i class="bi bi-envelope me-1 text-muted"></i>@item.Email</div>
                                    <div class="small"><i class="bi bi-telephone me-1 text-muted"></i>@item.Phone</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.Source</span></td>
                                <td>
                                    <span class="badge @(item.Status == "Converted" ? "bg-success" : (item.Status == "Qualified" ? "bg-primary" : (item.Status == "Lost" ? "bg-danger" : "bg-warning text-dark")))">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(item.Priority == "High" ? "bg-danger" : (item.Priority == "Medium" ? "bg-primary" : "bg-secondary"))">
                                        @item.Priority
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">@item.ExpectedValue.ToString("C0")</td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.LeadId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (item.Status != "Converted")
                                        {
                                            <a asp-action="Convert" asp-route-id="@item.LeadId" class="btn btn-outline-success" title="Convert to Customer">
                                                <i class="bi bi-person-check-fill"></i>
                                            </a>
                                        }

                                        <button type="button" class="btn btn-outline-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteLead-@item.LeadId">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade" id="deleteLead-@item.LeadId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Confirm Deletion</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to delete lead <strong>@item.LeadName</strong> (@item.LeadCode)?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@item.LeadId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No leads found matching your criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2 px-3 border-top">
            <span class="small text-muted">Page @currentPage of @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
